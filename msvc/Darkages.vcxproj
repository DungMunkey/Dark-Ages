  <!-- Stop early, with a useful message, if the SDL libraries have not been fetched yet. -->
  <Target Name="DACheckDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DASDL2)include\SDL.h') Or !Exists('$(DASDLTTF)include\SDL_ttf.h') Or !Exists('$(DASDLMixer)include\SDL_mixer.h')"
           Text="The SDL libraries were not found in $(DAThirdParty). Run tools\get-deps.ps1 first (see README)." />
  </Target>
  <!-- The exe needs the SDL DLLs next to it; keep them in game/ up to date after every build. -->
  <Target Name="DACopyRuntimeDlls" AfterTargets="Build">
    <ItemGroup>
      <DARuntimeDll Include="$(DASDL2)lib\x64\SDL2.dll" />
      <DARuntimeDll Include="$(DASDLTTF)lib\x64\SDL2_ttf.dll;$(DASDLTTF)lib\x64\libfreetype-6.dll;$(DASDLTTF)lib\x64\zlib1.dll" />
      <DARuntimeDll Include="$(DASDLMixer)lib\x64\SDL2_mixer.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DARuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
