# Visual Studio / MSVC build output
.vs/
x64/
x86/
[Dd]ebug/
[Rr]elease/

# Visual Studio user-specific files
*.vcxproj.user

# MSVC intermediate/output files
*.obj
*.pdb
*.ilk
*.iobj
*.ipdb
*.tlog
*.log
